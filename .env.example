# MongoDB root credentials (used only inside the private Docker network)
MONGO_USER=shopadmin
MONGO_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Session cookie signing key — must be at least 32 random characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_STRING

# The single admin login for the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Starting cash balance, in integer paise (e.g. 1000000 = ₹10,000.00).
OPENING_BALANCE_PAISE=0

# Set to "true" only if the app is served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false
